# Roboflow API key for FishTracker_v2 dataset download.
# Obtain from https://app.roboflow.com/settings/api
ROBOFLOW_API_KEY=

# Weights & Biases API key for training experiment tracking.
# Obtain from https://wandb.ai/authorize
WANDB_API_KEY=

# Wandb team/organization (optional; leave blank for personal account).
WANDB_ENTITY=

# Approved RF-DETR model for the web monitoring recognition path.
# This must be an explicit approved local model path. The web app does not
# fall back to bundled base weights when this value is missing or invalid.
# Start the backend with ML dependencies, for example: uv run --group ml uvicorn web.app:app --host 0.0.0.0 --port 8000
RFDETR_MODEL_PATH=models/rf-detr-fish.pth
RFDETR_DEVICE=auto
RFDETR_CONFIDENCE_THRESHOLD=0.25

# RTSP source used by the backend detector.
# The frontend receives the matching WebRTC WHEP URL from /config. If the
# backend runs in WSL or Docker, this URL must be reachable from that runtime,
# not just from the Windows browser.
STREAM_URL=rtsp://192.168.137.157:8554/cam
MEDIAMTX_WEBRTC_PORT=8889
SOURCE_ID=cam
MEDIAMTX_HOST=192.168.137.157
