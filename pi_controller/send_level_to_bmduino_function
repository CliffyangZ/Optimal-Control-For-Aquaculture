import serial
import time

def send_level_to_bmduino(level, port="/dev/ttyACM0", baudrate=9600):
    """
    level:
    0 = 輕度
    1 = 中度
    2 = 重度
    """

    if level not in [0, 1, 2]:
        raise ValueError("level 必須是 0、1、2")

    with serial.Serial(port, baudrate, timeout=1) as ser:
        time.sleep(2)
        ser.write((str(level) + "\n").encode("ascii"))
        ser.flush()

        response = ser.readline().decode(errors="ignore").strip()
        return response


# 使用範例
send_level_to_bmduino(0)  # 輕度
send_level_to_bmduino(1)  # 中度
send_level_to_bmduino(2)  # 重度
